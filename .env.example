DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=true
DEEPSEEK_MAX_TOKENS=0

GODOT_AI_MCP_URL=http://127.0.0.1:8000/mcp
GODOT_AI_MCP_TRANSPORT=http
GODOT_AI_HTTP_PORT=8000
GODOT_AI_WS_PORT=9500
GODOT_AI_STDIO_COMMAND=godot-ai
GODOT_AI_STDIO_ARGS=["attach","--port","8000","--ws-port","9500"]

GODOT_AI_TOOL_INCLUDE=
GODOT_AI_TOOL_EXCLUDE=

BRIDGE_MAX_TOOL_TURNS=0
BRIDGE_MAX_TOOL_RESULT_CHARS=100000
BRIDGE_DRY_RUN=false
BRIDGE_STREAM=true
BRIDGE_VERBOSE=false
DSH_WEB_ENABLED=true
DSH_PARALLEL_TOOLS=true

# dsh Godot dock service
DSH_GODOT_PROJECT_ROOT=
DSH_GODOT_WS_HOST=127.0.0.1
DSH_GODOT_WS_PORT=9600

# Optional multimodal vision description for screenshots.
# Any OpenAI-compatible vision endpoint works (OpenAI, Groq, xAI, ...).
DSH_VISION_API_KEY=
DSH_VISION_BASE_URL=https://api.openai.com/v1
DSH_VISION_MODEL=gpt-4o-mini
